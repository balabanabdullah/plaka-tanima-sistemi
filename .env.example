# Uygulama Genel Konfigürasyonu
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Kamera cihaz indeksi (0: varsayılan kamera, 1: örneğin DroidCam sanal kamera)
CAMERA_SOURCE=0

# Veri Tabanı Ayarları (Boş bırakılırsa yerel SQLite varsayılanı kullanılır: data/plate_system.db)
DATABASE_URL=

# Bulut HTTPS Senkronizasyon API Ayarları (HTTPS / Port 443 üzerinden senkronizasyon)
# CLOUD_SYNC_API_URL: Cloud Run servisinin temel HTTPS adresi (örn. https://plaka-web.a.run.app)
CLOUD_SYNC_API_URL=https://plaka-web-777971424350.europe-west1.run.app

# SYNC_API_TOKEN: Senkronizasyon API yetkilendirme token'ı (ortak gizli anahtar)
# Önemli: Gerçek token'ı kesinlikle git deposuna commitlemeyin.
SYNC_API_TOKEN=

# Eski / Doğrudan Bulut Veri Tabanı Bağlantısı (İsteğe bağlı legacy direct Cloud SQL)
CLOUD_DATABASE_URL=

# ESP32 Bağlantı Ayarları
ESP32_IP=192.168.1.100
ESP32_PORT=80
