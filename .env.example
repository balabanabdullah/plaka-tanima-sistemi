# Uygulama Genel Konfigürasyonu
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Kamera Ayarları (0: Dahili USB Kamera, 1: Harici USB Kamera, veya RTSP IP Kamera URL)
CAMERA_SOURCE=0

# Veri Tabanı Ayarları (Boş bırakılırsa yerel SQLite varsayılanı kullanılır: data/plate_system.db)
DATABASE_URL=

# Bulut Veri Tabanı Senkronizasyon Ayarları (Buluta tek yönlü senkronizasyon için PostgreSQL URL'si)
# Örnek: postgresql+psycopg2://plaka_user:PASSWORD@/plaka_db?host=/cloudsql/PROJECT:REGION:INSTANCE
CLOUD_DATABASE_URL=

# ESP32 Bağlantı Ayarları
ESP32_IP=192.168.1.100
ESP32_PORT=80
